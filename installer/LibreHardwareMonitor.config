<?xml version="1.0" encoding="utf-8"?>
<!--
  Config pré-configurado do LibreHardwareMonitor para o serviço RMM-LHM.
  Coloque ao lado do LibreHardwareMonitor.exe.

  Chaves relevantes:
    runWebServerMenuItem  → habilita o servidor HTTP em /data.json
    listenerPort          → porta TCP local (default LHM = 8085)
    minTrayMenuItem       → minimiza para a bandeja ao iniciar
    startMinMenuItem      → inicia minimizado (útil rodando via NSSM)
    autoStartMenuItem     → false: o NSSM cuida da inicialização

  Demais flags habilitam todos os sensores (CPU/GPU/disco/placa-mãe)
  para que o caminho HTTP do agente sempre encontre o CPU package.
-->
<configuration>
  <appSettings>
    <add key="runWebServerMenuItem" value="true" />
    <add key="listenerPort"        value="8085" />
    <add key="minTrayMenuItem"     value="true" />
    <add key="startMinMenuItem"    value="true" />
    <add key="minCloseMenuItem"    value="true" />
    <add key="autoStartMenuItem"   value="false" />

    <!-- Sensores: liga todos -->
    <add key="mainboardMenuItem"   value="true" />
    <add key="cpuMenuItem"         value="true" />
    <add key="ramMenuItem"         value="true" />
    <add key="gpuMenuItem"         value="true" />
    <add key="fanControllerMenuItem" value="true" />
    <add key="hddMenuItem"         value="true" />
    <add key="nicMenuItem"         value="true" />

    <!-- Tipos de leitura -->
    <add key="voltMenuItem"        value="true" />
    <add key="clocksMenuItem"      value="true" />
    <add key="loadMenuItem"        value="true" />
    <add key="tempMenuItem"        value="true" />
    <add key="fansMenuItem"        value="true" />
    <add key="controlsMenuItem"    value="true" />
    <add key="powersMenuItem"      value="true" />
    <add key="dataMenuItem"        value="true" />
    <add key="factorsMenuItem"     value="true" />

    <add key="celsiusMenuItem"     value="true" />
    <add key="hideShowMenuItem"    value="false" />
  </appSettings>
</configuration>
